# Project URL only — no /rest/v1/ suffix (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only key. Prefer secret key (sb_secret_…).
# If you see "JWT issued at future", use Legacy → service_role instead (same env var).
SUPABASE_SECRET_KEY=sb_secret_...

# shared app password for the login page
APP_PASSWORD=change-me

# random string for signing the session cookie (openssl rand -hex 32) — not a Supabase key
AUTH_SECRET=generate-a-long-random-string
